{
  "version": 1,
  "note": "鼠标规则 = 目标区 × 按钮 × 触发方式 × 修饰键 -> 动作。这个文件随程序分发，拿来就能用，可直接改；删掉某条规则即禁用该行为（不再叠加内置默认）。target 可选：empty(文件列表空白)/file/folder/tab/tab_close/new_tab/bookmark/bookmark_folder/bookmark_empty/nav/tree/address/search/toolbar/status/status_seg/view/title/overflow/group/column/preview。button：left/right/middle/x1/x2。trigger：single/double/hold/wheel_up/wheel_down/wheel_left/wheel_right。mods：1=Ctrl 2=Shift 4=Alt（可相加，如 5=Ctrl+Alt）。action：command 或 none（none=显式吞掉默认行为）。command 支持 Name:arg 内联参数，如 view.zoom:1。Find 从后往前匹配，同一组合写在后面的规则优先。可用命令见 cmd.help（或 tools/agentctl.py tools）。",
  "rules": [
    { "target": "empty", "button": "left", "trigger": "double", "mods": 0, "action": "command", "command": "nav.up" },
    { "target": "bookmark_empty", "button": "left", "trigger": "double", "mods": 0, "action": "command", "command": "bmk.toggle" },
    { "target": "status", "button": "left", "trigger": "double", "mods": 0, "action": "command", "command": "path.copy.dir" },

    { "target": "view", "button": "left", "trigger": "wheel_up", "mods": 1, "action": "command", "command": "view.zoom:1" },
    { "target": "view", "button": "left", "trigger": "wheel_down", "mods": 1, "action": "command", "command": "view.zoom:-1" },

    { "target": "empty", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "empty", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "unknown", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "unknown", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "view", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "view", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "tab", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "tab", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "nav", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "nav", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "address", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "address", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "tree", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "tree", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "status", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "status", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "status_seg", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "status_seg", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "preview", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "preview", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "bookmark", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "bookmark", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "bookmark_folder", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "bookmark_folder", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" },
    { "target": "bookmark_empty", "button": "x1", "trigger": "single", "mods": 0, "action": "command", "command": "nav.back" },
    { "target": "bookmark_empty", "button": "x2", "trigger": "single", "mods": 0, "action": "command", "command": "nav.forward" }
  ]
}
