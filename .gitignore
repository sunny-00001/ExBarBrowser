# ExBarBrowser 本地构建产物与临时文件
# 注：仓库根的 .gitignore 已排除 ExBarBrowser/*.exe|png|log 与 backup/，
#     这里再列一遍是为了本目录被单独取用（或作为子模块）时也成立。

# 构建产物
*.exe
*.dll
# 例外：AI 面板运行时加载的官方 WebView2 加载器，发布包必须自带。
# 只放行仓库根这一份，其余 *.dll 仍一律忽略。
!/WebView2Loader.dll
*.obj
*.o
*.map
*.pdb
*.ilk
# scripts/package_release.py 的发布暂存目录与压缩包
dist/

# 运行期 / 开发期产物
*.log
backup/
.takeover
shot*.png
out*.png

# 崩溃转储：tools/crash_capture.cpp 以调试器方式拉起目标进程，在首次真实异常时
# 用 MiniDumpWithFullMemory 写全内存 dump（单份可到几百 MB）。它是**调试证据**
# 而不是产物，但绝不入库 —— 否则 git status / dev.diff 会被几百 MB 的二进制淹没。
# 注意：转储是"证据"不是"垃圾"，回收器不自动删它（没人写它并不等于没人还在分析它）。
crashdumps/

# Python 字节码：tools/ 下的 CLI 每次运行都可能生成，不入库
__pycache__/
*.pyc

# 编辑器 / 系统
.vs/
.vscode/
*.swp
Thumbs.db
desktop.ini

# 迁移期归档（旧构建产物）
.old/
*.running.exe

# 测试全量运行的落点（tests/run_all.sh 的 OUT，默认工程根 tmp_tests/）。
# 名字带 tmp 前缀 → tools/reclaim.py 会当会话目录在构建收尾兜底回收；
# 其中 exe 由脚本跑完即删，这里整目录忽略，避免日志/obj 混进 git。
tmp*/

# 增量构建中间产物：obj/（以及多会话隔离目录 obj.*/、obj_*/）下的依赖文件(.d)、
# 预编译头(.gch)、签名(.build_sig) 以及 src/common.h.gch —— 这些由 build_fast.py
# 生成，clean 后应可全部消失
obj*/
*.d
*.gch

# 构建进行中的持锁标记（见 tools/reclaim.py 的 active_locks）：build_fast.py 在
# 中间目录里写 {pid=…}，回收器靠它跳过"卡住的构建"。它不是产物，不该入库。
.reclaim-lock

# 编辑期临时备份：app.cpp.bak / app.cpp.iconbak / nav_bar.cpp.fixbak /
# bookmark_bar.cpp.bak2 / popup_list.cpp.scrollbak / build_fast.py.iconbak …
*bak
*bak[0-9]

# ---------------------------------------------------------------------------
# 便携模式的用户数据：配置平铺在 data\，状态/日志/缓存/运行文件与它平级
#
# 这些文件因人而异（书签、最近访问、窗口几何、键位习惯），提交会把个人数据带进仓库，
# 因此运行期文件都不入库。旧布局留在 data\ 下的审计/发现文件也继续忽略，供升级期回退。
#
#   浏览器偏好    data\settings.json
#   书签          data\bookmarks.html
#   键位          data\keymap.json
#   鼠标规则      data\mouse.json
#   AI 行为配置   data\aichat.json（无密钥）
#   模型与密钥    data\models.json（含明文 apiKey，绝不入库）
#   MCP 清单      data\mcp.json
#   运行期状态    state\*.json
#   审计日志      logs\audit.jsonl（规范格式，R18/C6 要求的那份）
#                 logs\audit.log（旧文本格式）
# ---------------------------------------------------------------------------
data/settings.json
data/settings.json.tmp
data/settings.json.bak
data/bookmarks.html
data/keymap.json
# mouse.json 是随程序分发的出厂规则表（用户可直接改），必须入库并进发布包；
# 开发者本机对它的改动若不想提交，用 git update-index --skip-worktree 局部屏蔽。
# data/mouse.json  ← 有意不忽略
data/aichat.json
data/aichat.json.bak-*
data/models.json
data/models.json.bak-*
data/mcp.json
data/audit.log
data/audit.log.1
data/audit.jsonl
data/audit.jsonl.1
# 事件流落盘（B8）：跨重启观测历史，含轮转副本。与审计同理不入库；
# 被忽略才不会被 dev.diff 当成"未跟踪改动"混进候选源码。
logs/events.jsonl
logs/events.jsonl.1
data/events.jsonl
data/events.jsonl.1
data/events-test/
data/ai-token.txt
data/ai-pipe.txt
data/.write-probe
# AI 面板的 WebView2 用户数据目录：src/aichat_panel.cpp 把 user-data-dir 挂在
# Config::CacheDir()\webview2 —— 默认 profile 是 <exe>\cache\webview2，多实例/profile
# 则落在 <profile 根>\cache\webview2。缓存可整体删重建，不与低频配置混放。
# 跟 profile 根走是为了让隔离生效：多实例共用同一份 user-data-dir 会撞 Chromium
# 单例锁，且各 profile 的 localStorage 会互相污染。
# 它是运行期 profile —— 缓存、Local State、Cookies 等，不是构建产物。
/cache/webview2/
# 旧布局回退：发现文件/测试 profile 曾平铺在 data\ 下，升级期仍可能残留。
# 每实例发现文件（多实例并存时各写一份）与测试 profile：运行期产物，不入库
data/ai-token.*.txt
data/ai-pipe.*.txt
data/profile-multi/
# 结构化测试用的旧隔离 profile（EXBARBROWSER_PROFILE=data\profile-*）：
# 新布局改用 <exe>\profiles\*，下面两行只为升级期残留留个后路。
data/profile-*/
# agentctl 记录的"自己启的实例"（新位置 runtime\.agentctl.pid，旧位置也忽略）
data/.agentctl.pid
# dev.snapshot 落盘的工作树快照（改动文件的内容副本 + 清单）。
# 它是**兜底**不是备份：里面存的是工作树里当时的内容，入库等于把
# 未提交的改动塞进仓库历史。不入库，但**不能删** —— dev.rollback 靠它还原。
snapshots/
# dev.archive 的候选档案：源码副本 + 原始执行轨迹（逐字，不摘要）。
# 与 snapshots/ 同理不入库；被忽略才不会被 dev.diff 当成"未跟踪改动"。
archive/
# 程序自动生成的书签备份（含用户数据，绝不入库）
data/*.backup-*.html

# ---------------------------------------------------------------------------
# 分层运行期目录（profile 根下，与 data/ 平级）
#
#   state/    会话/历史/标签/窗口几何
#   logs/     审计/事件/会话日志
#   cache/    WebView2 用户数据
#   runtime/  AI 通道发现文件（进程退出即删）
#
# 这些目录全部由程序生成，且含用户数据或本机状态，绝不入库。
# 用前导 / 限定在仓库根，避免误伤 aichat/logs 等嵌套目录。
# ---------------------------------------------------------------------------
/state/
/logs/
/cache/
/runtime/
/profiles/

# 已废弃的旧命名（曾用 browser- 前缀，已合并进 keymap.json / mouse.json）
data/browser.json
data/browser-keymap.json
data/browser-mouse.json
data/bookmarks.default.html
data/*.from-appdata
# Agent 工作区（随会话上下文）
.workbuddy/

# ---------------------------------------------------------------------------
# aichat/ —— AI 聊天面板（Node 服务 + WebView2 前端）
#
# 只入库**代码**。下面这些是运行期产物与本机凭据，绝不入库：
#
#   aichat/service/{config,model}.json  旧布局遗留，model.json 里有明文 API key
#                                       （provider 的 apiKey 字段）。入库等于把
#                                       密钥写进仓库历史，删都删不干净。
#   *.bak-<时间戳>                      config.js 每次保存配置时留的旧副本，同样含 key。
#   *.opus.bak                          Opus 时代的实现副本，含当时的桥配置。
#   logs/                               会话历史（用户与 AI 的对话原文）。
#
# 现行配置在 data\aichat.json / data\models.json / data\mcp.json，由代码生成默认值；
# 不再提供 *.example.json 模板。
# ---------------------------------------------------------------------------
aichat/service/model.json
aichat/service/model.json.bak-*
aichat/service/config.json
aichat/service/config.json.bak-*
aichat/service/*.opus.bak
aichat/logs/
# Node 若被塞进 node_modules（当前零依赖，但别让它哪天混进来）
aichat/node_modules/
# 从 Opus 时代迁过来、已无调用方的模块（tools.js / opus.js / mcp-exbar.js）。
# 移到这里只为可回溯，不参与构建、不入库 —— 它们里面那份 allowedRoots
# 执行点曾经是"以为有边界"的错觉来源。
aichat/_removed_opus/

# 临时探针/复验脚本（并行会话的一次性验证产物，不参与构建、不入库）。
# 命名约定 tmp_ 前缀 = 临时；src/ 下以 tmp_ 开头的 .cpp 也不参与构建
# （build_fast.py 排除 tmp_* / _* / *.bak.cpp）。
tmp_*
